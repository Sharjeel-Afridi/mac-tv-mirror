<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV home-screen banner (320×180 dp). Placeholder until there is real artwork. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#1E88E5" />
        </shape>
    </item>
    <item android:left="60dp" android:top="45dp" android:right="60dp" android:bottom="45dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#0D2B4A" />
            <stroke android:width="4dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
